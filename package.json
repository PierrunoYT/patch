{
  "name": "patch",
  "productName": "Patch",
  "version": "0.1.0",
  "description": "AI coding assistant desktop app",
  "author": "PierrunoYT <pierrebruno@hotmail.ch>",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:sandbox && electron-vite dev",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:sandbox && electron-vite build",
    "build:sandbox": "node scripts/build-native.mjs",
    "start": "npm run build && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run build:sandbox && vitest run --project unit --passWithNoTests",
    "test:coverage": "npm run build:sandbox && vitest run --project unit --coverage",
    "test:sandbox": "vitest run --project unit src/main/tools/sandbox",
    "test:e2e": "npm run build && vitest run --project e2e",
    "perf": "npm run build && vitest run --project perf",
    "bench:agent": "npm run build && vitest run --project bench",
    "mutate": "node scripts/mutation-test.mjs",
    "pack": "node scripts/ensure-closed.mjs && node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run build && electron-builder --dir --publish never",
    "dist": "node scripts/ensure-closed.mjs && node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "io.github.pierrunoyt.patch",
    "publish": null,
    "productName": "Patch",
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json",
      "README.md",
      "LICENSE",
      "!node_modules/**",
      "node_modules/@anthropic-ai/sdk/**",
      "node_modules/@babel/runtime/**",
      "node_modules/@kwsites/file-exists/**",
      "node_modules/@kwsites/promise-deferred/**",
      "node_modules/@mozilla/readability/**",
      "node_modules/@simple-git/args-pathspec/**",
      "node_modules/@simple-git/argv-parser/**",
      "node_modules/@stablelib/base64/**",
      "node_modules/boolbase/**",
      "node_modules/css-select/**",
      "node_modules/css-what/**",
      "node_modules/cssom/**",
      "node_modules/debug/**",
      "node_modules/diff/**",
      "node_modules/dom-serializer/**",
      "node_modules/domelementtype/**",
      "node_modules/domhandler/**",
      "node_modules/domutils/**",
      "node_modules/entities/**",
      "node_modules/fast-sha256/**",
      "node_modules/html-escaper/**",
      "node_modules/htmlparser2/**",
      "node_modules/ignore/**",
      "node_modules/json-schema-to-ts/**",
      "node_modules/linkedom/**",
      "node_modules/ms/**",
      "node_modules/node-addon-api/**",
      "node_modules/node-pty/**",
      "node_modules/nth-check/**",
      "node_modules/openai/**",
      "node_modules/simple-git/**",
      "node_modules/standardwebhooks/**",
      "node_modules/ts-algebra/**",
      "node_modules/uhyphen/**",
      "node_modules/zod/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "native/sandbox-helper/target/release/file-helper",
          "to": "file-helper"
        }
      ],
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/node-pty/prebuilds/darwin-*/**",
      "singleArchFiles": "node_modules/node-pty/prebuilds/darwin-*/**",
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}",
      "category": "public.app-category.developer-tools",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "extraResources": [
        {
          "from": "native/sandbox-helper/target/release/file-helper",
          "to": "file-helper"
        },
        {
          "from": "native/sandbox-helper/target/release/net-bridge",
          "to": "net-bridge"
        }
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "category": "Development",
      "executableName": "patch-app"
    },
    "deb": {
      "packageName": "patch-app"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}",
      "extraResources": [
        {
          "from": "native/sandbox-helper/target/release/sandbox-helper.exe",
          "to": "sandbox-helper.exe"
        },
        {
          "from": "native/sandbox-helper/target/release/file-helper.exe",
          "to": "file-helper.exe"
        },
        {
          "from": "native/sandbox-helper/target/release/net-bridge.exe",
          "to": "net-bridge.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Installer.${ext}",
      "uninstallDisplayName": "${productName}",
      "differentialPackage": false
    },
    "dmg": {
      "artifactName": "${productName}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.10",
    "linkedom": "^0.18.13",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "node-pty": "^1.1.0",
    "openai": "^7.23.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.5"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
